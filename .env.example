# pdf-ingest Configuration
# Copy to .env and customize

# Ollama Settings
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b

# Use local embeddings (SentenceTransformers) instead of Ollama
# USE_LOCAL_EMBEDDINGS=false
# LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_STRATEGY=semantic  # semantic, recursive, character

# Vector Store
VECTOR_STORE=faiss  # faiss or chroma
VECTOR_STORE_PATH=./data/vector_store

# Search
TOP_K=5
SIMILARITY_THRESHOLD=0.3
USE_HYBRID_SEARCH=true

# LLM Generation
TEMPERATURE=0.1
MAX_TOKENS=2048
SYSTEM_PROMPT="You are a helpful assistant that answers questions based only on the provided context. Cite your sources using [chunk_id] format. If the context doesn't contain the answer, say 'I don't have enough information to answer this question.'"

# Processing
BATCH_SIZE=16
NUM_WORKERS=4

# Output
OUTPUT_DIR=./output
EXPORT_FORMATS=json,markdown,txt